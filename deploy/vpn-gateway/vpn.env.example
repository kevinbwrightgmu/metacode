# Copy to vpn.env (or run ./setup.sh). vpn.env holds secrets: never commit it.
# Any provider gluetun supports works; these are the Mullvad WireGuard settings.
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
# From your Mullvad account → WireGuard configuration → generate a key, download
# a config file: PrivateKey = …  and  Address = 10.x.x.x/32 (the IPv4 part only)
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Optional: where the exit should be, e.g. USA, Sweden, Germany (gluetun's names)
SERVER_COUNTRIES=
# The proxy's own password, so only MetaCode uses it
HTTPPROXY_USER=metacode
HTTPPROXY_PASSWORD=
