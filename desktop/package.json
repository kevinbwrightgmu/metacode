{
  "name": "metacode-sheets",
  "productName": "MetaCode Sheets",
  "version": "1.0.0",
  "description": "MetaCode Sheets — the MetaCode desktop spreadsheet for Pro, Max and Ultra subscribers",
  "main": "src/main/main.js",
  "private": true,
  "author": "MetaCode",
  "homepage": "https://metac0.de",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "sync": "node scripts/sync-vendor.js",
    "test": "node --test --test-force-exit \"test/*.test.mjs\" \"test/*.test.js\"",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 \"test/e2e/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "node scripts/build.js",
    "dist:linux": "node scripts/build.js --linux",
    "dist:win": "node scripts/build.js --win",
    "dist:mac": "node scripts/build.js --mac"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "playwright-core": "1.63.0"
  }
}
