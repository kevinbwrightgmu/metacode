{
  "name": "metacode",
  "version": "1.0.0",
  "description": "AI-assisted social media content analysis and intercoder reliability platform for researchers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "test": "node --test --test-force-exit \"test/**/*.test.js\"",
    "billing:check": "node accounts/check-billing.js",
    "test:unit": "node --test --test-force-exit test/targets.test.js test/format-export.test.js test/network.test.js test/jobs.test.js test/sandbox.test.js",
    "typecheck": "tsc -p tsconfig.json",
    "collector:install": "npm --prefix collector install",
    "collector:dev": "npm --prefix collector run dev",
    "collector:build": "npm --prefix collector run build",
    "collector:test": "npm --prefix collector test"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/merge": "6.12.2",
    "@mercuryworkshop/epoxy-tls": "2.1.19-1",
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/wisp-js": "0.5.0",
    "@supabase/supabase-js": "2.117.3",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "codemirror": "6.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pyodide": "^314.0.7",
    "quickjs-emscripten": "^0.32.0",
    "undici": "^6.29.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3"
  }
}
