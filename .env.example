# ── AI provider: EMIS (OpenAI-compatible gateway) ─────────────────────────────
# Copy this file to .env and put your EMIS key below (keys are issued manually
# by EMIS). The key stays on this computer: MetaCode's server uses it to call
# EMIS and never sends it to the browser, logs it or returns it.
# Several keys can be listed, comma-separated; MetaCode rotates between them
# and skips a key whose quota is used up until EMIS says it resets.
EMIS_API_KEY=emis-...

# EMIS API address (this is the default; change it only if EMIS tells you to).
EMIS_BASE_URL=https://emis.zxs-is-very.cool/v1

# Optional: the model to use when none is picked in Settings → Fetch Models
# (or the picked one isn't in the model list). Leave empty to use the first
# model in emis-models.json.
EMIS_MODEL=

# Optional: the model list file (EMIS's models in OpenCode's config format).
# Default: emis-models.json in the MetaCode folder. If the file is missing,
# MetaCode asks EMIS for its live model list instead.
# EMIS_MODELS_FILE=emis-models.json

# Optional: how long to wait for EMIS, in milliseconds (default 120000).
# EMIS_TIMEOUT_MS=120000

# ── Server port (default: 3000) ───────────────────────────────────────────────
PORT=3000
